# Base URL API 9router (OpenAI-compatible), tanpa slash di akhir
NINEROUTER_BASE_URL=http://localhost:20128/v1
# API key dari dashboard 9router (JANGAN di-commit)
NINEROUTER_API_KEY=
# Model default bila belum memilih di UI (mis. nama combo/model di 9router)
DEFAULT_MODEL=
PORT=3001
# Proxy hanya bind ke 127.0.0.1. Buka UI via http://localhost:5173 (dev)
# atau http://127.0.0.1:3001 (produksi). Bukan untuk akses LAN/publik.
# Timeout (ms): batas menunggu respons pertama dan jeda antar-chunk
REQUEST_TIMEOUT_MS=120000
ENABLE_PYTHON_SANDBOX=false
PYTHON_SANDBOX_IMAGE=9router-python:local